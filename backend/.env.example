# Optional OpenAI-compatible provider. Leave unset to disable live provider calls.
# Inject credentials through your deployment secret manager; never commit real keys.
AGENTBOX_OPENAI_API_KEY=
AGENTBOX_OPENAI_BASE_URL=https://api.openai.com/v1

# Set both rates to enable cost calculation. Otherwise cost_usd is null (unknown).
# AGENTBOX_OPENAI_INPUT_USD_PER_MILLION=
# AGENTBOX_OPENAI_OUTPUT_USD_PER_MILLION=

# Optional PostgreSQL connector provenance trust store (JSON object: key ID -> base64 raw 32-byte Ed25519 public key).
# Provision public keys out-of-band through the deployment secret/configuration manager.
# Private signing keys remain only in the connector environment; never place them in AgentBox.
# Signed snapshot attestations are accepted for 15 minutes after signed_at.
# AGENTBOX_POSTGRESQL_PROVENANCE_KEYS={"warehouse-connector-v1":"<base64-ed25519-public-key>"}
