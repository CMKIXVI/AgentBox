# Next.js web console — copy to .env.local for local development.
# Use real deployment values only in a secret manager; never commit secrets.
AUTH_SECRET=
AGENTBOX_OIDC_CLIENT_ISSUER=
AGENTBOX_OIDC_WEB_CLIENT_ID=
AGENTBOX_OIDC_WEB_CLIENT_SECRET=
AGENTBOX_OIDC_SCOPES=openid profile email offline_access
AGENTBOX_API_BASE_URL=http://127.0.0.1:8000
