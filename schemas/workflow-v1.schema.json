{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbox.example/schemas/workflow-v1.schema.json",
  "title": "AgentBox Workflow v1",
  "description": "Declarative workflow graph. It contains references and constraints, never executable code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "version",
    "name",
    "entry_node_id",
    "nodes",
    "edges",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "workflow_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "entry_node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "created_at"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "authored",
            "imported",
            "derived",
            "generated"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 100
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "license_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512
        }
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "type",
        "name"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "type": {
          "type": "string",
          "enum": [
            "trigger",
            "agent",
            "tool",
            "decision",
            "human_approval",
            "loop"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "agent_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512
        },
        "capability_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512
        },
        "approval_action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "input_schema_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512
        },
        "output_schema_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "source_node_id",
        "target_node_id",
        "kind"
      ],
      "properties": {
        "edge_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target_node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "type": "string",
          "enum": [
            "default",
            "true",
            "false",
            "loop_back"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 120
        }
      }
    }
  }
}
