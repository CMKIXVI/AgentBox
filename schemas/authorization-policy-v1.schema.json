{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbox.example/schemas/authorization-policy-v1.schema.json",
  "title": "AgentBox Authorization Policy v1",
  "description": "Explicit allow/deny policy for a capability action and exact resource set.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "version", "active", "effect", "capability_id", "principal_scope", "principal_ids", "tenant_ids", "actions", "resource_ids", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "active": {"type": "boolean"},
    "effect": {"type": "string", "enum": ["allow", "deny"]},
    "capability_id": {"type": "string", "minLength": 3, "maxLength": 128},
    "principal_scope": {"type": "string", "enum": ["user", "tenant", "service", "system"]},
    "principal_ids": {"type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "tenant_ids": {"type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "actions": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "resource_ids": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "not_before": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "provenance_ref": {"type": "string", "minLength": 1, "maxLength": 512}
  }
}
