{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbox.local/schemas/authentication-config-v1.schema.json",
  "title": "AgentBox OIDC Authentication Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "issuer", "audience", "jwks_uri", "algorithms", "tenant_claim"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "provider": {"const": "oidc"},
    "issuer": {"type": "string", "format": "uri", "minLength": 1, "maxLength": 2048},
    "audience": {"type": "string", "minLength": 1, "maxLength": 512},
    "jwks_uri": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
    "algorithms": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["RS256", "RS384", "RS512", "ES256", "ES384", "ES512", "EdDSA"]}
    },
    "tenant_claim": {"type": "string", "minLength": 1, "maxLength": 128},
    "subject_claim": {"type": "string", "const": "sub"},
    "leeway_seconds": {"type": "integer", "minimum": 0, "maximum": 60},
    "jwks_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 15}
  }
}
