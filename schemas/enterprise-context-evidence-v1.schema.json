{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbox.example/schemas/enterprise-context-evidence-v1.schema.json",
  "title": "AgentBox Enterprise Context Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "entity_id",
    "entity_version",
    "source_kind",
    "source_ref",
    "observed_at",
    "confidence"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "entity_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128
    },
    "entity_version": {
      "type": "integer",
      "minimum": 1
    },
    "relationship_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128
    },
    "source_kind": {
      "type": "string",
      "enum": [
        "database_metadata",
        "api_metadata",
        "repository_metadata",
        "configuration_metadata",
        "event_log",
        "human_attestation",
        "agent_analysis",
        "other"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "unverified",
        "validated",
        "rejected"
      ],
      "default": "unverified"
    },
    "metadata": {
      "type": "object",
      "maxProperties": 32
    }
  }
}
