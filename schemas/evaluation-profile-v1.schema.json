{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbox.example/schemas/evaluation-profile-v1.schema.json",
  "title": "AgentBox Evaluation Profile v1",
  "description": "Declarative, versioned evaluation cases, scoring weights and promotion gates. No executable evaluator code is embedded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "version", "name", "description", "scoring", "gates", "cases"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile_id": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "maxLength": 2000},
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correctness_weight", "latency_weight", "cost_weight"],
      "properties": {
        "correctness_weight": {"type": "number", "minimum": 0, "maximum": 1},
        "latency_weight": {"type": "number", "minimum": 0, "maximum": 1},
        "cost_weight": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_case_pass_rate", "max_avg_latency_ms", "max_total_cost_usd"],
      "properties": {
        "min_case_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "max_avg_latency_ms": {"type": "number", "exclusiveMinimum": 0},
        "max_total_cost_usd": {"type": "number", "minimum": 0}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "input", "assertions"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "description": {"type": "string", "maxLength": 1000},
          "input": {},
          "assertions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "expected_value"],
                  "properties": {
                    "type": {"const": "exact_match"},
                    "expected_value": {}
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "expected_value"],
                  "properties": {
                    "type": {"const": "contains"},
                    "expected_value": {"type": "string", "minLength": 1}
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "fields"],
                  "properties": {
                    "type": {"const": "required_fields"},
                    "fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "schema"],
                  "properties": {
                    "type": {"const": "json_schema_valid"},
                    "schema": {"type": "object"}
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}