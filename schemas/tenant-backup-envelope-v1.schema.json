{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbox.local/schemas/tenant-backup-envelope-v1.schema.json",
  "title": "AgentBox encrypted tenant backup envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "algorithm",
    "key_id",
    "tenant_id",
    "nonce",
    "ciphertext"
  ],
  "properties": {
    "format": {
      "const": "agentbox-tenant-backup"
    },
    "version": {
      "const": 1
    },
    "algorithm": {
      "const": "AES-256-GCM"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_]{0,63}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    },
    "nonce": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 16,
      "maxLength": 16
    },
    "ciphertext": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 24,
      "maxLength": 715827884
    }
  }
}
