{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbox.example/schemas/enterprise-context-event-v1.schema.json",
  "title": "AgentBox Enterprise Context Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "object_type",
    "object_id",
    "observed_at",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "event_type": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_.]*$"
    },
    "object_type": {
      "enum": [
        "entity",
        "relationship",
        "evidence",
        "source"
      ]
    },
    "object_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128
    },
    "object_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "source_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "maxProperties": 32
    }
  }
}
