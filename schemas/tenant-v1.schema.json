{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbox.local/schemas/tenant-v1.schema.json",
  "title": "AgentBox Tenant",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "display_name", "status", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "tenant_id": {"type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 200},
    "status": {"enum": ["pending", "active", "suspended", "decommissioned"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "metadata": {"type": "object", "maxProperties": 32, "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}
  }
}