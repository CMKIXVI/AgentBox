{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbox.example/schemas/enterprise-context-relationship-v1.schema.json",
  "title": "AgentBox Enterprise Context Relationship v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "relationship_id",
    "relationship_type",
    "source_entity_id",
    "source_version",
    "target_entity_id",
    "target_version",
    "attributes",
    "assertion_class",
    "confidence"
  ],
  "properties": {
    "relationship_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "relationship_type": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "source_entity_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128
    },
    "source_version": {
      "type": "integer",
      "minimum": 1
    },
    "target_entity_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128
    },
    "target_version": {
      "type": "integer",
      "minimum": 1
    },
    "attributes": {
      "type": "object",
      "maxProperties": 32
    },
    "assertion_class": {
      "enum": [
        "observed_fact",
        "inferred",
        "ai_hypothesis",
        "human_validated"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_to": {
      "type": "string",
      "format": "date-time"
    }
  }
}
