{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbox.example/schemas/enterprise-context-entity-v1.schema.json",
  "title": "AgentBox Enterprise Context Entity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entity_id",
    "entity_type",
    "name",
    "attributes",
    "assertion_class",
    "confidence"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "entity_type": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "default": ""
    },
    "attributes": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null",
          "object",
          "array"
        ]
      }
    },
    "assertion_class": {
      "enum": [
        "observed_fact",
        "inferred",
        "ai_hypothesis",
        "human_validated"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_to": {
      "type": "string",
      "format": "date-time"
    }
  }
}
