{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbox.local/schemas/oidc-client-registration-v1.schema.json",
  "title": "AgentBox Provider-Neutral OIDC Client Registration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "clients"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "protocol": {"const": "oidc"},
    "clients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/client"}
    }
  },
  "$defs": {
    "redirectUri": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "maxLength": 2048
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_id", "platform", "client_type",
        "token_endpoint_auth_method", "redirect_uris",
        "response_type", "pkce_method"
      ],
      "properties": {
        "client_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "platform": {"enum": ["web", "native"]},
        "client_type": {"enum": ["public", "confidential"]},
        "token_endpoint_auth_method": {
          "enum": ["none", "client_secret_basic", "private_key_jwt"]
        },
        "client_secret_ref": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{2,255}$"
        },
        "redirect_uris": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/redirectUri"}
        },
        "post_logout_redirect_uris": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/redirectUri"}
        },
        "response_type": {"const": "code"},
        "pkce_method": {"const": "S256"}
      }
    }
  }
}
