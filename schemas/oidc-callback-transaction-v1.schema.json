{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbox.local/schemas/oidc-callback-transaction-v1.schema.json",
  "title": "AgentBox OIDC Callback Transaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "transaction_id", "client_id", "redirect_uri",
    "state_hash", "nonce_hash", "pkce_verifier_ref",
    "created_at_epoch", "expires_at_epoch"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "transaction_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "client_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "redirect_uri": {"type": "string", "format": "uri", "minLength": 1, "maxLength": 2048},
    "state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonce_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pkce_verifier_ref": {"type": "string", "minLength": 3, "maxLength": 256},
    "created_at_epoch": {"type": "integer", "minimum": 0},
    "expires_at_epoch": {"type": "integer", "minimum": 1}
  }
}